# ─────────────────────────────────────────────────────────────────────────────
# MaintenanceCare — environment
#
# Copy to .env.local for development. On Vercel, set these in
# Project Settings → Environment Variables. See SETUP.md for how to obtain each.
#
# The marketing pages are statically generated and need none of these to build.
# The request form needs DATABASE_URL and the Resend keys to be useful.
# ─────────────────────────────────────────────────────────────────────────────

# Neon Postgres. Every submission is persisted here before the email is sent.
# Use the POOLED connection string.
DATABASE_URL=

# Resend — the lead notification email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Lead routing. Comma-separated. These two MUST NOT share an address:
# a twenty-door portfolio inquiry must never sit behind a request to hang a TV.
LEAD_NOTIFY_PRIORITY=
LEAD_NOTIFY_STANDARD=

# Vercel Blob — photo uploads from the request form.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile. Without these the form still works and the server
# verifies open, which is what makes a preview deployment usable.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis — 5 submissions per IP per hour. Fails open if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical origin, no trailing slash, e.g. https://maintenancecare.com
NEXT_PUBLIC_SITE_URL=
